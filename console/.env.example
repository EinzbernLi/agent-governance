# Copy to your shell/environment; never commit a real token.
# Required: set the target governance repository in owner/name form.
GOV_CONSOLE_REPOSITORY=
# Required: set the positive Issue number that is the configured Lead Claim sink.
GOV_CONSOLE_LEAD_ISSUE=
# Optional: defaults to main when omitted or blank.
GOV_CONSOLE_BRANCH=main
# Optional: when supplied, use a token with read access to the configured repository.
GOV_CONSOLE_GITHUB_TOKEN=
