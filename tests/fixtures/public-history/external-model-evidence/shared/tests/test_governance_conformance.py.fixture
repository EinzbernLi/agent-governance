                "0000000000000000000000000000000000000000",
                "templates/RESULT.md",
                evaluation,
            )
        )
        self.assertEqual(evaluation.result()["overall_status"], "BLOCKED")
        self.assertIn("HOT_PATH_CANONICAL_BLOB_UNAVAILABLE", {item["code"] for item in evaluation.findings})

