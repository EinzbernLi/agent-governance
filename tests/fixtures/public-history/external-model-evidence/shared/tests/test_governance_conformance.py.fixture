    def test_q10_lprl_pin_and_module_tree_preserved(self):
        accepted_release = self.base / "accepted-release.yaml"
        accepted_release.write_text(
            subprocess.run(
                ["git", "-C", str(REPO), "show", f"{ACCEPTED_0_3_15_COMMIT}:GOVERNANCE_RELEASE.yaml"],
                check=True,
                capture_output=True,
                text=True,
            ).stdout,
            encoding="utf-8",
        )
        self.assertEqual(
            CHECKER.load_yaml_subset(accepted_release)["modules"],
            CHECKER.load_yaml_subset(REPO / "GOVERNANCE_RELEASE.yaml")["modules"],
        )
        diff = subprocess.run(
            ["git", "-C", str(REPO), "diff", "--quiet", ACCEPTED_0_3_15_COMMIT, "--", "modules/local-resource-lifecycle"],
            check=False,
        )
        self.assertEqual(diff.returncode, 0)

